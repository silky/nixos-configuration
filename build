#!/usr/bin/env bash

set -e

# Regenerate the emacs keybinding cheat-sheet from init.el, so the
# checked-in EMACS-KEYS.md describes the config about to be deployed.
./users/noon/emacs-cheatsheet.el

export NIXPKGS_ALLOW_UNFREE=1

nixos-rebuild build --flake ".#${HOST}" --impure "$@" --show-trace

nvd diff /run/current-system result

sudo NIXPKGS_ALLOW_UNFREE=1 nixos-rebuild switch --flake ".#${HOST}" --impure "$@"
