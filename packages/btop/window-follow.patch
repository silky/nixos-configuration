diff --git a/src/btop_follow.hpp b/src/btop_follow.hpp
new file mode 100644
index 0000000..fa4037f
--- /dev/null
+++ b/src/btop_follow.hpp
@@ -0,0 +1,121 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+#include <charconv>
+#include <cstdint>
+#include <fstream>
+#include <limits>
+#include <optional>
+#include <sstream>
+#include <string>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+// Desktop helpers publish a process identity, never a command/name expression.
+// All state below is owned by btop's collector/renderer thread.
+namespace WindowFollow {
+
+enum class Kind { waiting, unavailable, process };
+
+struct Target {
+	Kind kind = Kind::unavailable;
+	uint64_t pid = 0, start_time = 0;
+
+	bool operator==(const Target&) const = default;
+};
+
+inline bool number(const std::string& text, uint64_t& value) {
+	const auto [end, error] = std::from_chars(text.data(), text.data() + text.size(), value);
+	return error == std::errc{} and end == text.data() + text.size();
+}
+
+inline Target parse(const std::string& text) {
+	std::istringstream input(text);
+	std::string first, second, extra;
+	input >> first;
+	if (first == "waiting" and not (input >> extra)) return {Kind::waiting};
+	if (first == "unavailable") return {};
+	Target target{Kind::process};
+	if (not (input >> second) or (input >> extra)
+		or not number(first, target.pid) or not number(second, target.start_time)
+		or target.pid == 0 or target.pid > std::numeric_limits<int>::max() or target.start_time == 0) return {};
+	return target;
+}
+
+inline std::string read_target(const std::string& path) {
+	std::ifstream input(path);
+	char line[128]{};
+	if (not input.getline(line, sizeof(line))) return "unavailable";
+	return line;
+}
+
+struct Identity {
+	uint64_t ppid = 0, start_time = 0;
+};
+
+inline std::optional<Identity> read_identity(const std::string& path) {
+	std::ifstream input(path);
+	std::string stat;
+	if (not std::getline(input, stat)) return {};
+	// comm may contain spaces and parentheses; fields start after the last ')'.
+	const auto end = stat.rfind(')');
+	if (end == std::string::npos) return {};
+	std::istringstream fields(stat.substr(end + 1));
+	std::string value;
+	Identity identity;
+	for (int field = 3; field <= 22; ++field) {
+		if (not (fields >> value)) return {};
+		if (field == 4 and not number(value, identity.ppid)) return {};
+		if (field == 22 and not number(value, identity.start_time)) return {};
+	}
+	return identity;
+}
+
+class Filter {
+	std::unordered_set<uint64_t> members;
+
+public:
+	Target target{Kind::waiting};
+	bool enabled = false;
+	bool alive = false;
+
+	bool scoped() const { return enabled and target.kind != Kind::waiting; }
+	bool includes(uint64_t pid) const { return not scoped() or members.contains(pid); }
+
+	template<class Processes>
+	bool refresh(Target next, bool next_enabled, const Processes& processes) {
+		const bool changed = target != next or enabled != next_enabled;
+		target = next;
+		enabled = next_enabled;
+		members.clear();
+		alive = false;
+		if (not scoped() or target.kind != Kind::process) return changed;
+
+		std::unordered_map<uint64_t, std::vector<uint64_t>> children;
+		for (const auto& process : processes) {
+			if (process.state == 'X') continue;
+			children[process.ppid].push_back(process.pid);
+			if (process.pid == target.pid and process.cpu_s == target.start_time) alive = true;
+		}
+		if (not alive) return changed;
+		std::vector<uint64_t> pending{target.pid};
+		while (not pending.empty()) {
+			const auto pid = pending.back();
+			pending.pop_back();
+			if (not members.insert(pid).second) continue;
+			if (auto it = children.find(pid); it != children.end())
+				pending.insert(pending.end(), it->second.begin(), it->second.end());
+		}
+		return changed;
+	}
+
+	std::string label() const {
+		if (not enabled) return "[w] Window: off";
+		std::string text = "[w] Window: follow ";
+		if (target.kind == Kind::waiting) return text + "waiting";
+		if (target.kind == Kind::unavailable) return text + "unavailable";
+		return text + (alive ? "PID " : "exited PID ") + std::to_string(target.pid);
+	}
+};
+}
